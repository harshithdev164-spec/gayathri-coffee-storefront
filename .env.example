# Postgres connection string (Neon)
DATABASE_URL=

# Neon Object Storage (S3-compatible) — for product images
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
PRODUCT_IMAGES_BUCKET=product-images

# Random secret used to sign the admin session cookie
ADMIN_SESSION_SECRET=

# Local dev port for the API server
PORT=5000

# Shiprocket seller account (Phase 4 — leave blank until provided)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pincode of the "Primary" pickup location in your Shiprocket dashboard — used for live rate lookups
SHIPROCKET_PICKUP_PINCODE=

# India Post CEPT external customer API — sandbox by default
INDIA_POST_BASE_URL=https://test.cept.gov.in/beextcustomer
INDIA_POST_USERNAME=
INDIA_POST_PASSWORD=
INDIA_POST_SOURCE_PINCODE=570001
INDIA_POST_BULK_CUSTOMER_ID=
INDIA_POST_CONTRACT_ID=

# Razorpay checkout — leave blank to keep the simulated-payment fallback
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Zoho ZeptoMail — order confirmation / shipping-update emails (leave blank to skip sending)
# ZEPTOMAIL_API_KEY is the FULL Authorization header value, including the "Zoho-enczapikey " prefix
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
EMAIL_FROM=
# Logo + site link used in the HTML email template (defaults to gayathricoffee.com if left blank)
EMAIL_LOGO_URL=
EMAIL_SITE_URL=

# Printed on the PDF invoice attached to order-confirmation emails / downloaded from the admin panel
INVOICE_BUSINESS_NAME=Gayathri Coffee Works
# Use \n for a second address line, wrapped in double quotes, e.g. "Line one\nLine two"
INVOICE_BUSINESS_ADDRESS=
INVOICE_BUSINESS_GSTIN=
INVOICE_BUSINESS_PAN=
INVOICE_BUSINESS_PHONE=
INVOICE_BUSINESS_WEBSITE=
INVOICE_BUSINESS_STATE=Karnataka
INVOICE_BUSINESS_STATE_CODE=29
# HSN code shown on invoice line items (single code assumed across the catalog)
INVOICE_HSN_CODE=0901
INVOICE_GST_RATE=5

# Razorpay webhook — verifies payment.captured/payment.failed callbacks (you choose this secret when creating the webhook in Razorpay's dashboard)
RAZORPAY_WEBHOOK_SECRET=
# Shiprocket webhook — shared token appended as ?token=<value> to the webhook URL you register with Shiprocket (no signature header support)
SHIPROCKET_WEBHOOK_SECRET=
# Meta WhatsApp webhook — verify token for the GET handshake in App Dashboard > WhatsApp > Configuration > Webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Meta WhatsApp Business Cloud API — order confirmation / shipped messages (leave blank to skip sending)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
# Comma-separated phone numbers (bare 10-digit Indian or 91-prefixed) that get backend order alerts
ADMIN_WHATSAPP_NUMBERS=
